{
  "name": "sovereign-library",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone, dependency-free software cubes",
  "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "check": "node --check cubes/browser/src/index.js",
