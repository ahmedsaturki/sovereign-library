{
  "name": "@sovereign/web-test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, dependency-free web testing product composed from Sovereign browser cubes.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#browser": "@sovereign/browser",
    "#browser-interactions": "@sovereign/browser-interactions",
    "#browser-assertions": "@sovereign/browser-assertions",
    "#browser-recorder": "@sovereign/browser-recorder"
  },
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test test/index.test.js"
  }
}
