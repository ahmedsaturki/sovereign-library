{
  "name": "@sovereign/automation",
  "version": "0.1.0",
  "private": true,
  "description": "Unified, dependency-free browser automation product composed from Sovereign cubes.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sovereign-automation": "./bin/cli.js"
  },
  "imports": {
    "#browser": "../../cubes/browser/src/index.js",
    "#browser-interactions": "../../cubes/browser-interactions/src/index.js",
    "#browser-assertions": "../../cubes/browser-assertions/src/index.js",
    "#browser-network-interception": "../../cubes/browser-network-interception/src/index.js",
    "#browser-tab-manager": "../../cubes/browser-tab-manager/src/index.js",
    "#browser-visual-testing": "../../cubes/browser-visual-testing/src/index.js",
    "#browser-recorder": "../../cubes/browser-recorder/src/index.js"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check bin/cli.js",
    "test": "node --test test/index.test.js",
    "smoke": "node bin/cli.js check"
  }
}
