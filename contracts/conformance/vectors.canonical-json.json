                                                [
                                                  [
                                                    [
                                                      [
                                                        [
                                                          [
                                                            [
                                                              [
                                                                [
                                                                  [
                                                                    [
                                                                      [
                                                                        [
                                                                          [
                                                                            [
                                                                              [
                                                                                [
                                                                                  [
                                                                                    [
                                                                                      [
                                                                                        [
                                                                                          1
                                                                                        ]
                                                                                      ]
                                                                                    ]
                                                                                  ]
                                                                                ]
                                                                              ]
                                                                            ]
                                                                          ]
                                                                        ]
                                                                      ]
                                                                    ]
                                                                  ]
                                                                ]
                                                              ]
                                                            ]
                                                          ]
                                                        ]
                                                      ]
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ],
      "expect": {
        "kind": "throws",
        "errorName": "CanonicalJsonError"
      }
    },
    {
      "id": "format-constant",
      "call": [
        "CANONICAL_JSON_FORMAT",
        []
      ],
      "expect": {
        "kind": "value",
        "value": "CJSON1"
      }
    },
    {
      "id": "limits-present",
      "call": [
        "CANONICAL_JSON_LIMITS",
        []
      ],
      "expect": {
        "kind": "shape",
        "requiredKeys": [
          "MAX_DEPTH",
          "MAX_NODES",
          "MAX_STRING_BYTES",
          "MAX_VALUE_BYTES"
        ]
      }
    }
  ]
}
