#!/usr/bin/env sh
# Gradle start up script
# 
# Important for running:
# 
# (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#     non-POSIX-compliant or you have a broken /bin/sh, then you must configure
#     your system such that /bin/sh points to a POSIX-compliant shell.
#
# (2) This script requires the following tools:
#     awk, basename, cat, chmod, cut, date, dirname, echo, egrep, expr,
#     grep, id, ls, ls -L, mkdir, mv, pwd, read, rm, sed, sleep, sort,
#     tr, uname
#
# (3) You must configure the environment variable GRADLE_USER_HOME or
#     GRADLE_HOME to point to the correct Gradle installation directory.
#     The value of GRADLE_HOME overrides GRADLE_USER_HOME.
#
# (4) For this script to be executable, you must make it executable.
#     chmod +x gradlew
#
# (5) If you want to use Gradle with a non-standard JVM, you must configure
#     the environment variable JAVA_HOME to point to the correct JVM location.
#
# (6) This script also uses the following environment variables, if they
#     are set:
#     GRADLE_OPTS    - Options to pass to the Gradle daemon.
#     GRADLE_HOME    - Overrides GRADLE_USER_HOME and points to the Gradle installation.
#     JAVA_HOME      - Points to the JVM installation.
#     JAVACMD        - The java executable to use.
#
# (7) This script works for Gradle 8.0 and later.
#
# (8) If the version of Gradle or the version of the JVM change, the
#     wrapper must be updated.

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname)" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MSYS* | MINGW* )
    msys=true
    ;;
  NONSTOP* )
    nonstop=true
    ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$darwin" = "false" -a "$nonstop" = "false" ] ; then
    MAX_FD_LIMIT=$(ulimit -H -n)
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD
    fi
fi

# For Darwin, add options to specify how the application appears in the dock
if $darwin; then
    GRADLE_OPTS="$GRADLE_OPTS \"-Xdock:name=$APP_NAME\" \"-Xdock:icon=$APP_HOME/media/gradle.icns\""
fi

# For Cygwin or MSYS, switch paths to Windows format before running java
if $cygwin ; then
    APP_HOME=$(cygpath --path --mixed "$APP_HOME")
    CLASSPATH=$(cygpath --path --mixed "$CLASSPATH")
    JAVACMD=$(cygpath --unix "$JAVACMD")
    # We build the pattern for arguments to be converted via cygpath
    ROOTDIRSRAW=""
    for arg in "$@" ; do
        CHECK=$(echo "$arg" | egrep -c ".*/.*")
        if [ $CHECK -ne 0 ] ; then
            ROOTDIRSRAW="$ROOTDIRSRAW $arg"
        fi
    done
    if [ -n "$ROOTDIRSRAW" ] ; then
        ROOTDIRS=$(cygpath --path --mixed $ROOTDIRSRAW)
    fi
fi

# Split up the JVM options and the Gradle options
JVM_OPTS=()
GRADLE_OPTS_ARRAY=()
for arg in "$@" ; do
    if [ "$arg" = "-J" ] || [ "$arg" = "--jvm-options" ] ; then
        # next arg is a JVM option
        shift
        JVM_OPTS+=("$1")
    else
        GRADLE_OPTS_ARRAY+=("$arg")
    fi
done

# Escape application args
save () {
    for arg in "$@" ; do
        printf "%s\n" "$arg" | sed 's/ /\ /g; s/"/\\"/g'
    done
}

# Collect all arguments for the java command, following the shell quoting and escaping rules
eval set -- $(save "${JVM_OPTS[@]}" "-classpath" "$CLASSPATH" "org.gradle.wrapper.GradleWrapperMain" "${GRADLE_OPTS_ARRAY[@]}")

# by default we should be in the project directory
cd "$APP_HOME" || die "ERROR: Could not change to project directory: $APP_HOME"

exec "$JAVACMD" "$@"
