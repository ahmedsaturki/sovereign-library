##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

app_path=$0
while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
      /*)   app_path=$link ;;
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_BASE_NAME=${0##*/}
APP_HOME=$( cd -P "${APP_HOME:-./}" > /dev/null && printf '%s\n' "$PWD" ) || exit

MAX_FD=maximum

warn () {
    echo "$*" >&2
}

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# Sovereign Library bootstrap: keep the wrapper JAR out of Git while
# deterministically bootstrapping the official Gradle 8.9 wrapper JAR.
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_URL="https://raw.githubusercontent.com/gradle/gradle/v8.9.0/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_SHA256="498495120a03b9a6ab5d155f5de3c8f0d986a449153702fb80fc80e134484f17"

if [ ! -f "$WRAPPER_JAR" ]; then
    mkdir -p "$(dirname "$WRAPPER_JAR")" || die "ERROR: Could not create the Gradle wrapper directory."
    tmp_wrapper_jar="$WRAPPER_JAR.tmp.$$"

    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error "$WRAPPER_URL" --output "$tmp_wrapper_jar" || {
            rm -f "$tmp_wrapper_jar"
            die "ERROR: Could not download the Gradle 8.9 wrapper JAR."
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$tmp_wrapper_jar" "$WRAPPER_URL" || {
            rm -f "$tmp_wrapper_jar"
            die "ERROR: Could not download the Gradle 8.9 wrapper JAR."
        }
    else
        die "ERROR: curl or wget is required to bootstrap the Gradle wrapper JAR."
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        actual_sha256=$(sha256sum "$tmp_wrapper_jar" | awk '{print $1}') || actual_sha256=
    elif command -v shasum >/dev/null 2>&1; then
        actual_sha256=$(shasum -a 256 "$tmp_wrapper_jar" | awk '{print $1}') || actual_sha256=
    elif command -v openssl >/dev/null 2>&1; then
        actual_sha256=$(openssl dgst -sha256 "$tmp_wrapper_jar" | awk '{print $NF}') || actual_sha256=
    else
        rm -f "$tmp_wrapper_jar"
        die "ERROR: No SHA-256 utility is available to verify the Gradle wrapper JAR."
    fi

    if [ "$actual_sha256" != "$WRAPPER_SHA256" ]; then
        rm -f "$tmp_wrapper_jar"
        die "ERROR: Gradle wrapper JAR SHA-256 mismatch.\nExpected: $WRAPPER_SHA256\nActual:   $actual_sha256"
    fi

    mv "$tmp_wrapper_jar" "$WRAPPER_JAR" || die "ERROR: Could not install the verified Gradle wrapper JAR."
fi

CLASSPATH=$WRAPPER_JAR

if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME\n\nPlease set the JAVA_HOME variable in your environment to match the\nlocation of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.\n\nPlease set the JAVA_HOME variable in your environment to match the\nlocation of your Java installation."
    fi
fi

cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in
  CYGWIN* )         cygwin=true  ;;
  Darwin* )         darwin=true  ;;
  MSYS* | MINGW* )  msys=true    ;;
  NONSTOP* )        nonstop=true ;;
esac

if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in
      max*)
        MAX_FD=$( ulimit -H -n ) || warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in
      '' | soft) :;;
      *)
        ulimit -n "$MAX_FD" || warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )
    JAVACMD=$( cygpath --unix "$JAVACMD" )

    for arg do
        if
            case $arg in
              -*)   false ;;
              /?*)  t=${arg#/} t=/${t%%/*}
                    [ -e "$t" ] ;;
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" )
        fi
        shift
        set -- "$@" "$arg"
    done
fi

DEFAULT_JVM_OPTS='-Dfile.encoding=UTF-8 "-Xmx64m" "-Xms64m"'

set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-[:alnum:]+,./:=@_]~\\&~g; ' |
        tr '\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"
